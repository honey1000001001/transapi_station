# ============================================================
# TransAPI Station Backend - Environment Configuration
# ============================================================

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Upstream proxy
UPSTREAM_BASE_URL=http://localhost:2063
UPSTREAM_API_KEY=sk-deepseek2api

# Admin account
ADMIN_EMAIL=admin@transapi.local
ADMIN_PASSWORD=changeme

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# App
APP_NAME=TransAPI Station
DEBUG=true
